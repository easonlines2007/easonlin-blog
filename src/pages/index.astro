---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getNotes } from '../lib/notes'
import { countValues, noteUrl } from '../lib/note-utils'
import { projects } from '../lib/projects'
import { theme } from '../site.config'
import HomeAvatar from '../components/HomeAvatar.astro'
import HomeEntrance from '../components/HomeEntrance.astro'
import HomeRow from '../components/HomeRow.astro'
import HomeMotto from '../components/HomeMotto.astro'
const notes = await getNotes()
const topics = countValues(notes, 'topic')
const pdfNotes = notes.filter((note) => note.data.pdf)
---

<BaseLayout title="首页" home>
  <HomeEntrance slot="head" />
  <section class="home-intro">
    <HomeAvatar />
    <h1 data-intro-name>{theme.author}</h1>
    <HomeMotto />
  </section>
  <div class="home-sections">
    <section class="home-section" data-intro-reveal>
      <h2>
        <span class="section-index" aria-hidden="true">
          01
        </span>
        关于
      </h2>
      <div class="section-body">
        <ul class="home-row-list">
          <HomeRow label="日常" title="学习笔记、阅读批注与零散思考" href="/about" />
        </ul>
        <a class="more-link" href="/about">
          <span class="lift-text">更多关于这里</span>
        </a>
      </div>
    </section>
    <section class="home-section" data-intro-reveal>
      <h2>
        <span class="section-index" aria-hidden="true">
          02
        </span>
        最近笔记
      </h2>
      <div class="section-body">
        <ul class="home-row-list">
          {notes.slice(0, 5).map((note) => (
            <HomeRow
              label={note.data.pdf ? 'PDF' : '笔记'}
              title={note.data.title}
              href={noteUrl(note.id)}
            />
          ))}
        </ul>
        <a class="more-link" href="/notes">
          <span class="lift-text">全部笔记</span>
        </a>
      </div>
    </section>
    <section class="home-section" data-intro-reveal>
      <h2>
        <span class="section-index" aria-hidden="true">
          03
        </span>
        项目
      </h2>
      <div class="section-body">
        <ul class="home-row-list">
          {projects
            .filter((project) => !project.fork)
            .slice(0, 3)
            .map((project) => (
              <HomeRow label="GitHub" title={project.name} href={project.url} external />
            ))}
        </ul>
        <a class="more-link" href="/projects">
          <span class="lift-text">全部项目与 GitHub 动态</span>
        </a>
      </div>
    </section>
    <section class="home-section" data-intro-reveal>
      <h2>
        <span class="section-index" aria-hidden="true">
          04
        </span>
        笔记一览
      </h2>
      <div class="section-body">
        <ul class="home-row-list">
          <HomeRow label="总计" title={`${notes.length} 篇笔记`} href="/notes" />
          <HomeRow label="专题" title={`${topics.length} 个笔记专题`} href="/notes/topics" />
          <HomeRow label="PDF" title={`${pdfNotes.length} 份手写与批注`} href="/notes/pdf" />
        </ul>
      </div>
    </section>
  </div>
</BaseLayout>
