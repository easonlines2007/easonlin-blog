---
import BaseLayout from '../layouts/BaseLayout.astro'
import Icon from '../components/Icon.astro'
import { getNotes } from '../lib/notes'
import { countValues, noteUrl } from '../lib/note-utils'
import { projects } from '../lib/projects'
import { theme } from '../site.config'
import { Image } from 'astro:assets'
import avatar from '../assets/avatar.png'
import HomeEntrance from '../components/HomeEntrance.astro'
const notes = await getNotes()
const topics = countValues(notes, 'topic')
---

<BaseLayout title="首页" home>
  <HomeEntrance slot="head" />
  <section class="home-intro">
    <div class="avatar" data-intro-avatar>
      <Image
        src={avatar}
        width={256}
        height={256}
        format="webp"
        alt="Eason Lin 的头像：戴墨镜、穿红毛衣的史努比"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="intro-heading">
      <span class="intro-eyebrow" data-intro-reveal>
        笔记与日常
      </span>
      <h1 data-intro-name>{theme.author}</h1>
    </div>
    <p data-intro-reveal>记录、整理，慢慢理解。</p>
    <a class="pill-link" href="/notes" data-intro-reveal>
      <Icon name="book" />
      翻开笔记
    </a>
  </section>
  <div class="home-sections">
    <section class="home-section" data-intro-reveal>
      <h2>
        <span class="section-index" aria-hidden="true">
          01
        </span>
        关于
      </h2>
      <div class="section-body">
        <p>一个存放学习笔记、阅读批注和零散思考的地方。</p>
        <a class="more-link" href="/about">
          更多关于这里
        </a>
      </div>
    </section>
    <section class="home-section" data-intro-reveal>
      <h2>
        <span class="section-index" aria-hidden="true">
          02
        </span>
        最近笔记
      </h2>
      <div class="section-body">
        <ul class="compact-notes">
          {notes.slice(0, 5).map((note) => (
            <li>
              <a class="compact-note" href={noteUrl(note.id)}>
                <span class="type">{note.data.pdf ? 'PDF' : '笔记'}</span>
                <span class="title">{note.data.title}</span>
                <Icon name="next" />
              </a>
            </li>
          ))}
        </ul>
        <a class="more-link" href="/notes">
          全部笔记
        </a>
      </div>
    </section>
    <section class="home-section" data-intro-reveal>
      <h2>
        <span class="section-index" aria-hidden="true">
          03
        </span>
        项目
      </h2>
      <div class="section-body">
        <ul>
          {projects
            .filter((project) => !project.fork)
            .slice(0, 3)
            .map((project) => (
              <li>
                <a class="topic-row" href={project.url} target="_blank" rel="noopener noreferrer">
                  <span>{project.name}</span>
                  <span>GitHub ↗</span>
                </a>
              </li>
            ))}
        </ul>
        <a class="more-link" href="/projects">
          全部项目与 GitHub 动态
        </a>
      </div>
    </section>
    <section class="home-section" data-intro-reveal>
      <h2>
        <span class="section-index" aria-hidden="true">
          04
        </span>
        笔记一览
      </h2>
      <div class="home-stats">
        <span>
          <strong>{notes.length}</strong>篇笔记
        </span>
        <span>
          <strong>{topics.length}</strong>个专题
        </span>
        <span>
          <strong>{notes.filter((note) => note.data.pdf).length}</strong>份 PDF
        </span>
      </div>
    </section>
  </div>
</BaseLayout>
