---
import BaseLayout from '../../../layouts/BaseLayout.astro'
import PageHeader from '../../../components/PageHeader.astro'
import Icon from '../../../components/Icon.astro'
import { getNotes } from '../../../lib/notes'
import { countValues, topicUrl } from '../../../lib/note-utils'
const topics = countValues(await getNotes(), 'topic')
---

<BaseLayout title="专题">
  <PageHeader title="专题" description="把相关的笔记放在一起，沿着一个主题慢慢读。" />
  <div class="index-grid enter delay-1">
    {topics.map(([topic, count]) => (
      <a class="index-card" href={topicUrl(topic)}>
        <div>
          <h2 class="lift-text">{topic}</h2>
          <p>{count} 篇笔记</p>
        </div>
        <Icon name="next" />
      </a>
    ))}
  </div>
</BaseLayout>
