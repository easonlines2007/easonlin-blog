---
import type { GetStaticPaths } from 'astro'
import NotesLayout from '../../../layouts/NotesLayout.astro'
import { getNotes } from '../../../lib/notes'
import { countValues } from '../../../lib/note-utils'
export const getStaticPaths = (async () => {
  const allNotes = await getNotes()
  return countValues(allNotes, 'tags').map(([tag]) => ({
    params: { tag },
    props: { tag, allNotes, notes: allNotes.filter((note) => note.data.tags.includes(tag)) }
  }))
}) satisfies GetStaticPaths
const { tag, notes, allNotes } = Astro.props
---

<NotesLayout title={`# ${tag}`} {notes} {allNotes} back="/notes/tags" backLabel="全部标签" />
