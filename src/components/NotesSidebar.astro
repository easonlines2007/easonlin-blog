---
import type { CollectionEntry } from 'astro:content'
import { countValues, statusLabels, tagUrl, topicUrl } from '../lib/note-utils'
import Icon from './Icon.astro'
interface Props {
  notes: CollectionEntry<'notes'>[]
  filterNotes?: CollectionEntry<'notes'>[]
  filters?: boolean
}
const { notes, filterNotes = notes, filters = false } = Astro.props
---

<aside class="notes-sidebar" aria-label="笔记分类">
  <section>
    <div class="sidebar-title">
      <h2>
        <Icon name="tag" />
        标签
      </h2>
      <a href="/notes/tags">
        <span class="lift-text">全部标签</span>
      </a>
    </div>
    <div class="tag-list">
      {countValues(notes, 'tags').map(([tag]) => (
        <a class="tag" href={tagUrl(tag)}>
          <span class="lift-text">{tag}</span>
        </a>
      ))}
    </div>
  </section>
  <section>
    <div class="sidebar-title">
      <h2>
        <Icon name="book" />
        专题
      </h2>
    </div>
    <ul class="sidebar-list">
      {countValues(notes, 'topic').map(([topic, count]) => (
        <li>
          <a href={topicUrl(topic)}>
            <span class="lift-text">{topic}</span>
            <span>{count}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
  {filters && (
    <section class="status-filter">
      <div class="sidebar-title">
        <h2>整理状态</h2>
      </div>
      <div class="filter-options" role="group" aria-label="按整理状态筛选">
        <button type="button" data-status-filter="all" aria-pressed="true">
          <span class="lift-text">全部笔记</span>
          <span>{filterNotes.length}</span>
        </button>
        {Object.entries(statusLabels).map(([status, label]) => (
          <button type="button" data-status-filter={status} aria-pressed="false">
            <span class="lift-text">{label}</span>
            <span>{filterNotes.filter((note) => note.data.status === status).length}</span>
          </button>
        ))}
      </div>
    </section>
  )}
</aside>
