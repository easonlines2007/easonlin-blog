---
import { localeFromPath, localizePath, useTranslations } from '@/lib/i18n'
import Icon from './Icon.astro'
import SectionTitle from './SectionTitle.astro'
const locale = localeFromPath(Astro.url.pathname)
const t = useTranslations(locale)
const path = (href: string) => localizePath(href, locale)
interface Props {
  title: string
  englishTitle?: string
  description?: string
  back?: string
  backLabel?: string
}
const { title, englishTitle, description, back, backLabel = '首页' } = Astro.props
---

{back && (
  <a class="back-link" href={path(back)}>
    <Icon name="back" />
    <span class="lift-text">{t(backLabel)}</span>
  </a>
)}
<div class:list={['page-heading', !back && 'page-heading-top', !englishTitle && 'enter']}>
  {englishTitle ? <SectionTitle title={t(title)} {englishTitle} /> : <h1>{t(title)}</h1>}
  {description && <p>{t(description)}</p>}
  <slot />
</div>
