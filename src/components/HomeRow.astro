---
import Icon from './Icon.astro'

interface Props {
  label?: string
  title: string
  meta?: string
  href: string
  external?: boolean
}
const { label, title, meta, href, external = false } = Astro.props
---

<li>
  <a
    class:list={['home-row', !label && 'home-row-plain', meta && 'home-row-meta']}
    {href}
    target={external ? '_blank' : undefined}
    rel={external ? 'noopener noreferrer' : undefined}
  >
    {label && <span class="home-row-label">{label}</span>}
    <span class="home-row-title lift-text">{title}</span>
    {meta && <span class="home-row-meta-text">{meta}</span>}
    <Icon name="next" />
  </a>
</li>
