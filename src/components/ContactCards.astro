---
import QrCodeCards from './QrCodeCards.astro'
import wechat from '../assets/contact/wechat.jpg'
import qq from '../assets/contact/qq.jpg'
import instagram from '../assets/contact/instagram.jpg'
import xiaohongshu from '../assets/contact/xiaohongshu.jpg'
const contacts = [
  { name: '微信', image: wechat, detail: '扫码添加好友', alt: '微信个人资料与联系二维码' },
  { name: 'QQ', image: qq, detail: '1042822846', alt: 'QQ 个人资料与联系二维码' },
  {
    name: 'Instagram',
    image: instagram,
    detail: '@eason_._lin',
    alt: 'Instagram 个人资料与联系二维码'
  },
  { name: '小红书', image: xiaohongshu, detail: '990246975', alt: '小红书个人资料与联系二维码' }
]
---

<QrCodeCards
  cards={contacts}
  idPrefix="contact"
  viewLabel="查看联系方式 ↗"
  closeLabel="关闭联系方式大图"
/>
