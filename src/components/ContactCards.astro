---
import { Image } from 'astro:assets'
import wechat from '../assets/contact/wechat.png'
import qq from '../assets/contact/qq.png'
import instagram from '../assets/contact/instagram.jpg'
import xiaohongshu from '../assets/contact/xiaohongshu.png'
const contacts = [
  { name: '微信', image: wechat, detail: '扫码添加好友', qr: { width: 900, centerY: 859 } },
  { name: 'QQ', image: qq, detail: '1042822846', qr: { width: 862, centerY: 940 } },
  {
    name: 'Instagram',
    image: instagram,
    detail: '@eason_._lin',
    qr: { width: 402, centerY: 533.5 }
  },
  { name: '小红书', image: xiaohongshu, detail: '990246975' }
]
// Center the three QR codes at the same 84% of the card width; keep the full originals in dialogs.
const qrCardWidth = 0.84
---

<div class="contact-grid">
  {contacts.map((contact, index) => (
    <figure class="contact-card">
      <button
        class="contact-image"
        class:list={{ 'contact-image-qr': Boolean(contact.qr) }}
        style={
          contact.qr
            ? `--image-width: ${(contact.image.width / contact.qr.width) * qrCardWidth * 100}%; --image-center-y: ${(contact.qr.centerY / contact.image.height) * 100}%`
            : undefined
        }
        type="button"
        data-contact-open={`contact-${index}`}
        aria-haspopup="dialog"
        aria-label={`查看${contact.name}联系方式大图`}
      >
        <Image
          src={contact.image}
          width={contact.image.width}
          height={contact.image.height}
          format="png"
          alt={`${contact.name}个人资料与联系二维码`}
          loading="lazy"
        />
        <span class="contact-cover" aria-hidden="true">
          <span class="contact-number">0{index + 1}</span>
          <strong>{contact.name}</strong>
          <span>查看联系方式 ↗</span>
        </span>
      </button>
      <figcaption>
        <strong>{contact.name}</strong>
        <span>{contact.detail}</span>
      </figcaption>
      <dialog
        id={`contact-${index}`}
        class="contact-dialog"
        aria-labelledby={`contact-title-${index}`}
      >
        <div class="contact-dialog-heading">
          <h3 id={`contact-title-${index}`}>{contact.name}</h3>
          <button type="button" data-contact-close aria-label="关闭联系方式大图" autofocus>
            <span class="lift-text">关闭 ×</span>
          </button>
        </div>
        <Image
          src={contact.image}
          width={contact.image.width}
          height={contact.image.height}
          format="png"
          alt={`${contact.name}完整个人资料与联系二维码`}
          loading="lazy"
        />
        <p>扫码或保存图片 · {contact.detail}</p>
      </dialog>
    </figure>
  ))}
</div>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-contact-open]').forEach((button) => {
    const dialog = document.getElementById(button.dataset.contactOpen!) as HTMLDialogElement
    button.addEventListener('click', () => dialog.showModal())
    dialog
      .querySelector<HTMLButtonElement>('[data-contact-close]')!
      .addEventListener('click', () => dialog.close())
    dialog.addEventListener('click', (event) => {
      if (event.target !== dialog) return
      const bounds = dialog.getBoundingClientRect()
      if (
        event.clientX < bounds.left ||
        event.clientX > bounds.right ||
        event.clientY < bounds.top ||
        event.clientY > bounds.bottom
      )
        dialog.close()
    })
  })
</script>
<style>
  .contact-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }
  .contact-card {
    margin: 0;
    min-width: 0;
  }
  .contact-image {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 0;
    overflow: hidden;
    background: #fff;
    color: var(--text);
  }
  .contact-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .contact-image-qr img {
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--image-width);
    max-width: none;
    height: auto;
    transform: translate(-50%, calc(-1 * var(--image-center-y)));
  }
  .contact-image:not(.contact-image-qr) img {
    object-position: center bottom;
    transform: scale(1.06);
    transform-origin: center bottom;
  }
  .contact-cover {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 10px;
    background: var(--soft);
    transition: opacity 360ms ease;
  }
  .contact-cover strong {
    font-family: var(--font-editorial);
    font-size: 23px;
    font-weight: 400;
  }
  .contact-cover > span:last-child {
    color: var(--secondary);
    font-size: 12px;
  }
  .contact-number {
    position: absolute;
    left: 18px;
    top: 15px;
    color: var(--accent);
    font-size: 10px;
    letter-spacing: 0.1em;
  }
  .contact-image:hover .contact-cover,
  .contact-image:focus-visible .contact-cover {
    opacity: 0;
  }
  figcaption {
    padding: 14px 2px 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
    font-size: 13px;
  }
  figcaption strong {
    font-weight: 500;
  }
  figcaption span {
    color: var(--secondary);
    font-size: 12px;
    overflow-wrap: anywhere;
  }
  .contact-dialog {
    width: min(560px, calc(100vw - 32px));
    max-height: calc(100dvh - 40px);
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: 12px;
    color: var(--text);
    background: var(--page-bg);
    overflow-y: auto;
  }
  .contact-dialog::backdrop {
    background: rgb(0 0 0 / 0.55);
    backdrop-filter: blur(5px);
  }
  .contact-dialog-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 14px;
  }
  .contact-dialog h3 {
    font-size: 16px;
    font-weight: 500;
  }
  .contact-dialog button {
    padding: 4px 9px;
    background: var(--soft);
    color: var(--text);
    border: 1px solid var(--line);
    border-radius: 5px;
    font-size: 13px;
  }
  .contact-dialog img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 5px;
  }
  .contact-dialog p {
    margin-top: 12px;
    font-size: 12px;
    color: var(--secondary);
  }
  @media (max-width: 800px) {
    .contact-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px 16px;
    }
  }
  @media (hover: none), (pointer: coarse) {
    .contact-cover {
      display: none;
    }
  }
  @media (max-width: 600px) {
    .contact-cover {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .contact-cover {
      transition: none;
    }
  }
</style>
