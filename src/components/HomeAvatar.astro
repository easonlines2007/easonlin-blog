---
import { localeFromPath, useTranslations } from '@/lib/i18n'
const locale = localeFromPath(Astro.url.pathname)
const t = useTranslations(locale)
import { Image } from 'astro:assets'
import avatar from '../assets/avatar.png'
import woodstock from '../assets/woodstock.png'
---

<div class="avatar" data-intro-avatar>
  <div class="avatar-card">
    <div class="avatar-face avatar-front">
      <Image
        src={avatar}
        width={256}
        height={256}
        format="webp"
        alt={t('Eason Lin 的头像：戴墨镜、穿红毛衣的史努比')}
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="avatar-face avatar-back" aria-hidden="true">
      <Image src={woodstock} width={256} height={256} format="webp" alt="" loading="eager" />
    </div>
  </div>
</div>
<style>
  .avatar {
    perspective: 650px;
  }
  .avatar-card {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 560ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .avatar-face {
    position: absolute;
    inset: 0;
    padding: 7px;
    border: 1px solid hsl(35 15% 76% / 0.4);
    border-radius: 3px;
    background: #fffdf8;
    box-shadow: 0 3px 10px #3027190d;
    backface-visibility: hidden;
  }
  .avatar-back {
    transform: rotateX(180deg);
  }
  @media (hover: hover) and (pointer: fine) {
    :global(html:not([data-home-entrance='pending'])) .avatar:hover .avatar-card {
      transform: rotateX(180deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .avatar-card {
      transition: none;
    }
  }
</style>
