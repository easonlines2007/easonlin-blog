---
import { Image } from 'astro:assets'
import avatar from '../assets/avatar.png'
---

<div class="avatar" data-intro-avatar data-avatar-tilt>
  <div class="avatar-card">
    <Image
      src={avatar}
      width={256}
      height={256}
      format="webp"
      alt="Eason Lin 的头像：戴墨镜、穿红毛衣的史努比"
      loading="eager"
      fetchpriority="high"
    />
  </div>
</div>
<script>
  import { setupAvatarTilt } from '../scripts/avatar-tilt'
  const avatar = document.querySelector<HTMLElement>('[data-avatar-tilt]')
  if (avatar) setupAvatarTilt(avatar)
</script>
<style>
  .avatar-card {
    position: relative;
    width: 100%;
    height: 100%;
    padding: 7px;
    border: 1px solid hsl(35 15% 76% / 0.4);
    border-radius: 3px;
    background: #fffdf8;
    box-shadow: 0 3px 10px #3027190d;
    transform: perspective(650px) rotateX(var(--avatar-tilt-x, 0deg))
      rotateY(var(--avatar-tilt-y, 0deg));
    transition:
      transform 420ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 300ms ease;
  }
  .avatar-card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: radial-gradient(
      circle at var(--avatar-glare-x, 50%) var(--avatar-glare-y, 50%),
      #fff6,
      #fff2 30%,
      transparent 70%
    );
    opacity: 0;
    transition: opacity 240ms ease;
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    [data-avatar-tilting] .avatar-card {
      transition-duration: 160ms, 300ms;
      box-shadow: 0 8px 18px #30271916;
    }
    [data-avatar-tilting] .avatar-card::after {
      opacity: 0.3;
    }
  }
</style>
