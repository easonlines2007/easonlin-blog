---
import type { CollectionEntry } from 'astro:content'
import { formatDate, noteUrl, tagUrl, statusLabels } from '../lib/note-utils'
interface Props {
  note: CollectionEntry<'notes'>
}
const { note } = Astro.props
const { title, description, tags, status, updated, date, pdf } = note.data
---

<li
  class="note-card"
  data-note-status={status}
  data-list-item
  data-sort-title={title}
  data-sort-date={date.getTime()}
>
  <div class="note-card-heading">
    <h2>
      <a class="note-title" href={noteUrl(note.id)}>
        <span class="lift-text">{title}</span>
      </a>
    </h2>
    <span class:list={['status', status]}>{statusLabels[status]}</span>
  </div>
  {description && <p class="note-description">{description}</p>}
  <div class="note-meta">
    <span class="content-type">{pdf ? 'PDF 笔记' : '笔记'}</span>
    <time datetime={date.toISOString()}>添加于 {formatDate(date)}</time>
    {updated && <time datetime={updated.toISOString()}>更新于 {formatDate(updated)}</time>}
    {tags.map((tag) => (
      <a class="tag" href={tagUrl(tag)}>
        <span class="lift-text">{tag}</span>
      </a>
    ))}
  </div>
</li>
