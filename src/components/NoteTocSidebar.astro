---
import type { MarkdownHeading } from 'astro'
import { localeFromPath, useTranslations } from '@/lib/i18n'
import TableOfContents from './TableOfContents.astro'

interface Props {
  headings: MarkdownHeading[]
}
const { headings } = Astro.props
const t = useTranslations(localeFromPath(Astro.url.pathname))
---

<aside class="toc-sidebar note-toc" aria-label={t('本页目录')}>
  <div class="note-toc-header">
    <h2 class="toc-title" data-note-toc-title>
      {t('本页目录')}
    </h2>
    <button
      class="toc-toggle"
      type="button"
      aria-expanded="true"
      aria-controls="note-toc-content"
      aria-label={t('收起目录')}
      title={t('收起目录')}
      data-note-toc-toggle
      data-label-expand={t('展开目录')}
      data-label-collapse={t('收起目录')}
      hidden
    >
      <svg
        class="toc-toggle-icon"
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path class="toc-icon-lines" d="M4 6h11M4 12h8M4 18h11" />
        <path class="toc-icon-arrow" d="m18 9 3 3-3 3" />
      </svg>
    </button>
  </div>
  <div class="note-toc-panel">
    <div id="note-toc-content">
      <TableOfContents {headings} />
    </div>
  </div>
</aside>

<script>
  import '../scripts/note-toc'
</script>
