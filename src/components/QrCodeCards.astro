---
import { localeFromPath, useTranslations } from '@/lib/i18n'
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Props {
  cards: { name: string; image: ImageMetadata; detail: string; alt: string }[]
  idPrefix: string
  viewLabel: string
  closeLabel: string
}
const { cards, idPrefix, viewLabel, closeLabel } = Astro.props
const locale = localeFromPath(Astro.url.pathname)
const t = useTranslations(locale)
---

<div class="contact-grid">
  {cards.map((contact, index) => (
    <div class="contact-card">
      <button
        class="contact-trigger"
        type="button"
        data-qr-open={`${idPrefix}-${index}`}
        aria-haspopup="dialog"
        aria-controls={`${idPrefix}-${index}`}
        aria-label={locale === 'en' ? `View ${t(contact.name)} image` : `查看${contact.name}大图`}
      >
        <span class="contact-image">
          <Image
            src={contact.image}
            width={contact.image.width}
            height={contact.image.height}
            format="png"
            alt={t(contact.alt)}
            loading="lazy"
          />
          <span class="contact-cover" aria-hidden="true">
            <span class="contact-number">0{index + 1}</span>
            <strong>{t(contact.name)}</strong>
            <span>{t(viewLabel)}</span>
          </span>
        </span>
        <span class="contact-caption">
          <strong>{t(contact.name)}</strong>
          <span>{t(contact.detail)}</span>
        </span>
      </button>
      <dialog
        id={`${idPrefix}-${index}`}
        class="contact-dialog"
        aria-labelledby={`${idPrefix}-title-${index}`}
      >
        <div class="contact-dialog-heading">
          <h3 id={`${idPrefix}-title-${index}`}>{t(contact.name)}</h3>
          <button type="button" data-qr-close aria-label={t(closeLabel)} autofocus>
            <span class="lift-text">{t('关闭 ×')}</span>
          </button>
        </div>
        <Image
          src={contact.image}
          width={contact.image.width}
          height={contact.image.height}
          format="png"
          alt={t(contact.alt)}
          loading="lazy"
        />
        <p>
          {locale === 'en' ? 'Scan or save the image' : '扫码或保存图片'} · {t(contact.detail)}
        </p>
      </dialog>
    </div>
  ))}
</div>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-qr-open]').forEach((button) => {
    const dialog = document.getElementById(button.dataset.qrOpen!) as HTMLDialogElement
    button.addEventListener('click', () => dialog.showModal())
    dialog
      .querySelector<HTMLButtonElement>('[data-qr-close]')!
      .addEventListener('click', () => dialog.close())
    dialog.addEventListener('click', (event) => {
      if (event.target !== dialog) return
      const bounds = dialog.getBoundingClientRect()
      if (
        event.clientX < bounds.left ||
        event.clientX > bounds.right ||
        event.clientY < bounds.top ||
        event.clientY > bounds.bottom
      )
        dialog.close()
    })
  })
</script>
<style>
  .contact-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }
  .contact-card {
    margin: 0;
    min-width: 0;
  }
  .contact-trigger {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    background: transparent;
    color: var(--text);
    text-align: left;
  }
  .contact-image {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 5 / 7;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0;
    overflow: hidden;
    background: #fff;
    color: var(--text);
    transition: border-color 160ms ease;
  }
  .contact-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .contact-cover {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 10px;
    background: var(--soft);
    transition: opacity 360ms ease;
  }
  .contact-cover strong {
    font-family: var(--font-editorial);
    font-size: 23px;
    font-weight: 400;
  }
  .contact-cover > span:last-child {
    color: var(--secondary);
    font-size: 12px;
  }
  .contact-number {
    position: absolute;
    left: 18px;
    top: 15px;
    color: var(--accent);
    font-size: 10px;
    letter-spacing: 0.1em;
  }
  .contact-trigger:hover .contact-cover,
  .contact-trigger:focus-visible .contact-cover {
    opacity: 0;
  }
  .contact-trigger:is(:hover, :focus-visible) .contact-image {
    border-color: hsl(var(--primary) / 0.4);
  }
  .contact-trigger:focus-visible {
    outline: none;
  }
  .contact-trigger:focus-visible .contact-image {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  .contact-caption {
    padding: 14px 2px 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
    font-size: 13px;
  }
  .contact-caption strong {
    font-weight: 500;
  }
  .contact-caption > span {
    color: var(--secondary);
    font-size: 12px;
    overflow-wrap: anywhere;
  }
  .contact-dialog {
    width: min(560px, calc(100vw - 32px));
    max-height: calc(100dvh - 40px);
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--text);
    background: var(--page-bg);
    overflow-y: auto;
  }
  .contact-dialog::backdrop {
    background: rgb(0 0 0 / 0.55);
    backdrop-filter: blur(5px);
  }
  .contact-dialog-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 14px;
  }
  .contact-dialog h3 {
    font-size: 16px;
    font-weight: 500;
  }
  .contact-dialog button {
    padding: 4px 9px;
    background: var(--soft);
    color: var(--text);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-size: 13px;
  }
  .contact-dialog img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
  }
  .contact-dialog p {
    margin-top: 12px;
    font-size: 12px;
    color: var(--secondary);
  }
  @media (max-width: 800px) {
    .contact-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px 16px;
    }
  }
  @media (hover: none), (pointer: coarse) {
    .contact-cover {
      display: none;
    }
  }
  @media (max-width: 600px) {
    .contact-cover {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .contact-cover,
    .contact-image {
      transition: none;
    }
  }
</style>
