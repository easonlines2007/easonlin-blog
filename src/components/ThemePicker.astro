---
import { localeFromPath, useTranslations } from '@/lib/i18n'
const t = useTranslations(localeFromPath(Astro.url.pathname))
---

<button
  class="theme-toggle icon-button"
  type="button"
  data-theme-toggle
  data-label-light={t('切换到浅色模式')}
  data-label-dark={t('切换到深色模式')}
  aria-label={t('切换到深色模式')}
  title={t('切换到深色模式')}
>
  <svg class="theme-icon" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
    <mask id="theme-moon-cutout" maskUnits="userSpaceOnUse" x="0" y="0" width="24" height="24">
      <rect width="24" height="24" fill="white" />
      <circle class="theme-cutout" cx="20" cy="4" r="6" fill="black" />
    </mask>
    <g mask="url(#theme-moon-cutout)">
      <circle class="theme-disc" cx="12" cy="12" r="7" fill="currentColor" />
    </g>
    <path
      class="theme-rays"
      d="M12 2v2m0 16v2M2 12h2m16 0h2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linecap="round"
    />
  </svg>
</button>

<script>
  import { normalizeTheme, type ThemePreference } from '../lib/theme'
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')!
  let preference: ThemePreference = normalizeTheme(
    document.documentElement.dataset.themePreference ?? null
  )

  function apply() {
    document.documentElement.classList.toggle('dark', preference === 'dark')
    document.documentElement.dataset.themePreference = preference
    document.documentElement.style.colorScheme = preference
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute('content', preference === 'dark' ? '#3b3935' : '#f2f0e8')
    const label = preference === 'dark' ? toggle.dataset.labelLight! : toggle.dataset.labelDark!
    toggle.setAttribute('aria-label', label)
    toggle.title = label
  }

  async function changeTheme() {
    if (toggle.disabled) return
    const root = document.documentElement
    const next = preference === 'dark' ? 'light' : 'dark'
    const commit = () => {
      preference = next
      apply()
      try {
        localStorage.setItem('notes-theme', preference)
      } catch {
        /* Keep the choice for this page when storage is unavailable. */
      }
    }
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      commit()
      return
    }

    toggle.disabled = true
    try {
      if (!document.startViewTransition) {
        root.dataset.themeFade = ''
        commit()
        await new Promise((resolve) => setTimeout(resolve, 350))
        return
      }

      // Viewport coordinates keep the reveal anchored to the button after scrolling.
      const bounds = toggle.getBoundingClientRect()
      const x = bounds.left + bounds.width / 2
      const y = bounds.top + bounds.height / 2
      const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y))
      root.style.setProperty('--theme-reveal-x', `${x}px`)
      root.style.setProperty('--theme-reveal-y', `${y}px`)
      root.style.setProperty('--theme-reveal-radius', `${radius + 2}px`)
      root.dataset.themeTransition = ''
      const transition = document.startViewTransition(commit)
      // Hidden tabs and interrupted captures can skip the animation but still apply the theme.
      await transition.ready.catch(() => {})
      await transition.finished
    } catch {
      if (preference !== next) commit()
    } finally {
      delete root.dataset.themeTransition
      delete root.dataset.themeFade
      root.style.removeProperty('--theme-reveal-x')
      root.style.removeProperty('--theme-reveal-y')
      root.style.removeProperty('--theme-reveal-radius')
      toggle.disabled = false
    }
  }

  toggle.addEventListener('click', () => void changeTheme())
  window.addEventListener('storage', (event) => {
    if (event.key === 'notes-theme' || event.key === null) {
      preference = normalizeTheme(event.newValue)
      apply()
    }
  })
  apply()
  requestAnimationFrame(() => toggle.setAttribute('data-ready', ''))
</script>

<style>
  .theme-icon {
    display: block;
    overflow: visible;
  }
  .theme-disc,
  .theme-rays {
    transform-origin: 12px 12px;
  }
  .theme-disc {
    transform: scale(0.57);
  }
  .theme-cutout {
    transform: translate(8px, -8px);
  }
  .theme-rays {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }
  :global(.dark) .theme-disc {
    transform: scale(1);
  }
  :global(.dark) .theme-cutout {
    transform: translate(-3px, 3px);
  }
  :global(.dark) .theme-rays {
    opacity: 0;
    transform: rotate(-45deg) scale(0.55);
  }
  .theme-toggle[data-ready] :is(.theme-disc, .theme-cutout) {
    transition: transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .theme-toggle[data-ready] .theme-rays {
    transition:
      transform 600ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 240ms ease;
  }
  @media (prefers-reduced-motion: reduce) {
    .theme-toggle[data-ready] :is(.theme-disc, .theme-cutout, .theme-rays) {
      transition: none;
    }
  }
</style>
