---
import { Image } from 'astro:assets'
import peanutsLineup from '../assets/characters/peanuts-lineup.png'
import doghouse from '../assets/characters/doghouse.png'
import woodstockWriting from '../assets/characters/woodstock-writing.png'
import snoopyReading from '../assets/characters/snoopy-reading.png'
import charlieBrown from '../assets/characters/charlie-brown.png'
import snoopyWoodstockHandshake from '../assets/characters/snoopy-woodstock-handshake.png'

const characters = {
  '/': peanutsLineup,
  '/notes': woodstockWriting,
  '/projects': doghouse,
  '/blog': snoopyReading,
  '/links': snoopyWoodstockHandshake,
  '/about': charlieBrown
}
interface Props {
  href: string
}
const { href } = Astro.props
const character = characters[href as keyof typeof characters]
const imageWidth = href === '/' ? 480 : 160
---

{character && (
  <span class="nav-character" aria-hidden="true">
    <Image
      src={character}
      width={imageWidth}
      height={Math.round((imageWidth * character.height) / character.width)}
      format="webp"
      alt=""
      loading="eager"
      draggable="false"
    />
  </span>
)}
