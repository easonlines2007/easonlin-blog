---
import type { projects } from '../lib/projects'
import Icon from './Icon.astro'
interface Props {
  project: (typeof projects)[number]
}
const { project } = Astro.props
---

<li>
  <a class="project-card" href={project.url} target="_blank" rel="noopener noreferrer">
    <span class="project-kind">{project.kind}</span>
    <h3 class="lift-text">{project.name}</h3>
    <p>{project.description}</p>
    <span class="project-meta">
      <span>{project.language ?? 'GitHub'}</span>
      <span class="project-open">
        <span class="lift-text">查看仓库</span> <Icon name="next" />
      </span>
    </span>
  </a>
</li>
<style>
  .project-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: 10px;
    transition:
      background-color 180ms ease,
      border-color 180ms ease;
  }
  .project-card:hover {
    background: var(--soft);
    border-color: var(--accent);
    color: var(--text);
  }
  .project-kind {
    color: var(--accent);
    font-size: 11px;
    letter-spacing: 0.04em;
  }
  h3 {
    font-size: 17px;
    font-weight: 500;
    overflow-wrap: anywhere;
    margin: 8px 0;
  }
  p {
    color: var(--secondary);
    font-size: 14px;
    line-height: 1.8;
    flex: 1;
  }
  .project-meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    color: var(--secondary);
    font-size: 12px;
    margin-top: 24px;
  }
  .project-open {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .project-open svg {
    width: 14px;
    height: 14px;
  }
</style>
