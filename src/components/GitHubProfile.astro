---
import { github } from '@/lib/projects'
import { localeFromPath } from '@/lib/i18n'

const locale = localeFromPath(Astro.url.pathname)
const profile = github.profile
const stats = [
  { value: profile.publicRepos, label: locale === 'en' ? 'Public repos' : '公开仓库' },
  { value: profile.followers, label: locale === 'en' ? 'Followers' : '关注者' },
  { value: profile.following, label: locale === 'en' ? 'Following' : '正在关注' }
]
---

<section class="github-profile entry-surface enter delay-1" aria-labelledby="github-profile-title">
  <div class="profile-main">
    <img
      class="profile-avatar"
      src={profile.avatarUrl}
      width="112"
      height="112"
      alt=""
      loading="lazy"
      decoding="async"
      referrerpolicy="no-referrer"
    />
    <div class="profile-copy">
      <span class="profile-eyebrow">GITHUB</span>
      <h2 id="github-profile-title">{profile.name}</h2>
      <p class="profile-handle">@{github.username}</p>
      {profile.bio && <p class="profile-bio">{profile.bio}</p>}
      <div class="profile-details">
        {profile.company && <p>{profile.company}</p>}
        {profile.location && <p>{profile.location}</p>}
      </div>
    </div>
    <a class="profile-link entry-link" href={profile.url} target="_blank" rel="noopener noreferrer">
      <span class="lift-text">{locale === 'en' ? 'View GitHub profile ↗' : 'GitHub 主页 ↗'}</span>
    </a>
  </div>
  <div class="profile-footer">
    <dl class="profile-stats">
      {stats.map((stat) => (
        <div>
          <dt>{stat.label}</dt>
          <dd>{stat.value}</dd>
        </div>
      ))}
    </dl>
    <p class="profile-updated">
      {locale === 'en' ? 'Updated' : '更新于'}{' '}
      <time datetime={github.updatedAt}>{github.updatedAt.slice(0, 10)}</time>
    </p>
  </div>
</section>

<style>
  .github-profile {
    margin-top: 36px;
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--soft);
  }
  .profile-main {
    display: flex;
    align-items: flex-start;
    gap: 24px;
  }
  .profile-avatar {
    flex: 0 0 112px;
    width: 112px;
    height: 112px;
    object-fit: cover;
    border-radius: 50%;
    border: 1px solid var(--line);
  }
  .profile-copy {
    flex: 1;
    min-width: 0;
  }
  .profile-eyebrow {
    color: var(--accent);
    font-size: 10px;
    letter-spacing: 0.15em;
  }
  h2 {
    margin: 5px 0 0;
    font-size: 26px;
    font-weight: 400;
  }
  .profile-handle {
    color: var(--secondary);
    font-size: 13px;
    overflow-wrap: anywhere;
  }
  .profile-bio {
    margin-top: 14px;
    font-size: 14px;
  }
  .profile-details {
    margin-top: 14px;
    font-size: 13px;
    color: var(--secondary);
    overflow-wrap: anywhere;
  }
  .profile-details p + p {
    margin-top: 4px;
  }
  .profile-link {
    flex-shrink: 0;
    padding: 7px 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-size: 13px;
  }
  .profile-link:hover {
    border-color: var(--accent);
  }
  .profile-footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }
  .profile-stats {
    display: flex;
    gap: 36px;
    margin: 0;
  }
  .profile-stats > div {
    display: flex;
    flex-direction: column-reverse;
    gap: 2px;
  }
  dt {
    color: var(--secondary);
    font-size: 12px;
  }
  dd {
    margin: 0;
    font-family: var(--font-editorial);
    font-size: 24px;
    line-height: 1.2;
  }
  .profile-updated {
    color: var(--secondary);
    font-size: 11px;
  }
  @media (max-width: 700px) {
    .github-profile {
      padding: 22px;
    }
    .profile-main {
      flex-wrap: wrap;
      gap: 20px;
    }
    .profile-avatar {
      flex-basis: 72px;
      width: 72px;
      height: 72px;
    }
    .profile-link {
      flex-basis: 100%;
      text-align: center;
    }
    .profile-stats {
      gap: 28px;
    }
  }
</style>
