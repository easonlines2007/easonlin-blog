---
import { theme } from '../site.config'
import Icon from './Icon.astro'
import ThemePicker from './ThemePicker.astro'
import NavCharacter from './NavCharacter.astro'
import LanguageSwitch from './LanguageSwitch.astro'
import Wordmark from './Wordmark.astro'
import { localeFromPath, localizePath, useTranslations } from '../lib/i18n'
interface Props {
  alternatePath: string | null
}
const { alternatePath } = Astro.props
const pathname = Astro.url.pathname
const locale = localeFromPath(pathname)
const t = useTranslations(locale)
const path = (href: string) => localizePath(href, locale)
const active = (href: string) => pathname === href || pathname.startsWith(`${href}/`)
---

<header class="site-header" data-pagefind-ignore>
  <a class="brand character-link" href={path('/')}>
    <span class="nav-flip">
      <span class="nav-label">
        <Wordmark kind="blog" />
      </span>
      <NavCharacter href="/" />
    </span>
  </a>
  <nav class="desktop-nav" aria-label={t('主导航')}>
    {theme.header.menu.map((item) => (
      <a
        class="character-link"
        href={path(item.link)}
        aria-current={active(path(item.link)) ? 'page' : undefined}
      >
        <span class="nav-flip">
          <span class="nav-label">{t(item.title)}</span>
          <NavCharacter href={item.link} />
        </span>
      </a>
    ))}
  </nav>
  <div class="header-actions">
    <a
      class="search-link icon-button"
      href={path('/search')}
      aria-label={t('搜索文章')}
      title={t('搜索文章')}
    >
      <Icon name="search" />
    </a>
    <LanguageSwitch href={alternatePath} />
    <ThemePicker />
    <details class="mobile-menu header-disclosure">
      <summary class="icon-button" aria-label={t('打开导航菜单')}>
        <Icon name="menu" />
      </summary>
      <nav aria-label={t('手机导航')}>
        {theme.header.menu.map((item, index) => (
          <a
            href={path(item.link)}
            aria-current={active(path(item.link)) ? 'page' : undefined}
            style={`--menu-item-index: ${index}`}
          >
            {t(item.title)}
          </a>
        ))}
      </nav>
    </details>
  </div>
</header>
<div class="header-backdrop" aria-hidden="true"></div>
<script>
  const header = document.querySelector<HTMLElement>('.site-header')!
  const disclosures = [...header.querySelectorAll<HTMLDetailsElement>('.header-disclosure')]
  const closing = new Set<HTMLDetailsElement>()
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)')

  function closeDisclosure(item: HTMLDetailsElement) {
    if (!item.open || closing.has(item)) return
    const nav = item.matches('.mobile-menu') ? item.querySelector('nav') : null
    const animations = nav?.getAnimations({ subtree: true }) ?? []
    if (reducedMotion.matches || !animations.length) {
      item.open = false
      return
    }

    // Keep native details visible until its opening animation has run backwards.
    closing.add(item)
    nav!.inert = true
    const endTime = Math.max(
      ...animations.map((animation) => Number(animation.effect!.getComputedTiming().endTime))
    )
    const panel = animations.find(
      (animation) => (animation.effect as KeyframeEffect).target === nav
    )!
    const time = panel.playState === 'finished' ? endTime : Number(panel.currentTime)
    animations.forEach((animation) => {
      // A shared timeline reverses the link stagger as well as the panel reveal.
      animation.updatePlaybackRate(-1.5)
      animation.play()
      animation.currentTime =
        animation === panel
          ? Math.min(time, Number(animation.effect!.getComputedTiming().endTime))
          : time
    })
    Promise.allSettled(animations.map((animation) => animation.finished)).then(() => {
      if (!closing.delete(item)) return
      item.open = false
      nav!.inert = false
    })
  }

  disclosures.forEach((item) => {
    item.querySelector('summary')?.addEventListener('click', (event) => {
      if (!item.open) return
      event.preventDefault()
      if (closing.delete(item)) {
        const nav = item.querySelector('nav')!
        nav.inert = false
        nav.getAnimations({ subtree: true }).forEach((animation) => {
          animation.updatePlaybackRate(1)
          animation.play()
        })
      } else {
        closeDisclosure(item)
      }
    })
  })
  let previousY = window.scrollY
  let scheduled = false
  function updateHeader() {
    const y = window.scrollY
    header.classList.toggle('is-scrolled', y > 24)
    header.classList.toggle(
      'is-hidden',
      y > 350 &&
        y > previousY &&
        !disclosures.some((item) => item.open) &&
        !header.contains(document.activeElement)
    )
    previousY = y
    scheduled = false
  }
  window.addEventListener(
    'scroll',
    () => {
      if (!scheduled) {
        requestAnimationFrame(updateHeader)
        scheduled = true
      }
    },
    { passive: true }
  )
  disclosures.forEach((item) =>
    item.addEventListener('toggle', () => {
      if (item.open) {
        // Browsers can retain CSS animations while a details subtree is hidden.
        item
          .querySelector('nav')
          ?.getAnimations({ subtree: true })
          .forEach((animation) => {
            if (animation.playbackRate < 0 && !closing.has(item)) {
              animation.playbackRate = 1
              animation.currentTime = 0
              animation.play()
            }
          })
        header.classList.remove('is-hidden')
        disclosures.forEach((other) => {
          if (other !== item) closeDisclosure(other)
        })
      }
    })
  )
  function closeOutside(event: Event) {
    disclosures.forEach((item) => {
      if (!item.contains(event.target as Node)) closeDisclosure(item)
    })
  }
  // Touching blank space in Safari can omit the synthetic click event.
  document.addEventListener('pointerdown', closeOutside)
  document.addEventListener('click', closeOutside)
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape')
      disclosures.forEach((item) => {
        if (item.open) {
          closeDisclosure(item)
          item.querySelector('summary')?.focus()
        }
      })
  })
  updateHeader()
</script>
