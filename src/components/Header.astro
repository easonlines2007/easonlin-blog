---
import { theme } from '../site.config'
import Icon from './Icon.astro'
import ThemePicker from './ThemePicker.astro'
import NavCharacter from './NavCharacter.astro'
import LanguageSwitch from './LanguageSwitch.astro'
import Wordmark from './Wordmark.astro'
import { localeFromPath, localizePath, useTranslations } from '../lib/i18n'
interface Props {
  alternatePath: string | null
}
const { alternatePath } = Astro.props
const pathname = Astro.url.pathname
const locale = localeFromPath(pathname)
const t = useTranslations(locale)
const path = (href: string) => localizePath(href, locale)
const active = (href: string) => pathname === href || pathname.startsWith(`${href}/`)
---

<header class="site-header" data-pagefind-ignore>
  <a class="brand character-link" href={path('/')}>
    <span class="nav-flip">
      <span class="nav-label">
        <Wordmark kind="blog" />
      </span>
      <NavCharacter href="/" />
    </span>
  </a>
  <nav class="desktop-nav" aria-label={t('主导航')}>
    {theme.header.menu.map((item) => (
      <a
        class="character-link"
        href={path(item.link)}
        aria-current={active(path(item.link)) ? 'page' : undefined}
      >
        <span class="nav-flip">
          <span class="nav-label">{t(item.title)}</span>
          <NavCharacter href={item.link} />
        </span>
      </a>
    ))}
  </nav>
  <div class="header-actions">
    <a
      class="search-link icon-button"
      href={path('/search')}
      aria-label={t('搜索文章')}
      title={t('搜索文章')}
    >
      <Icon name="search" />
    </a>
    <LanguageSwitch href={alternatePath} />
    <ThemePicker />
    <details class="mobile-menu header-disclosure">
      <summary class="icon-button" aria-label={t('打开导航菜单')}>
        <Icon name="menu" />
      </summary>
      <nav aria-label={t('手机导航')}>
        {theme.header.menu.map((item) => (
          <a href={path(item.link)} aria-current={active(path(item.link)) ? 'page' : undefined}>
            {t(item.title)}
          </a>
        ))}
      </nav>
    </details>
  </div>
</header>
<div class="header-backdrop" aria-hidden="true"></div>
<script>
  const header = document.querySelector<HTMLElement>('.site-header')!
  const disclosures = [...header.querySelectorAll<HTMLDetailsElement>('.header-disclosure')]
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)')
  const motions = new Map<HTMLDetailsElement, { expanded: boolean; animations: Animation[] }>()
  const hiddenPanel: Keyframe = {
    opacity: '0',
    transform: 'translateY(-6px) scale(0.98)',
    clipPath: 'inset(-12px -28px 100% -28px round var(--radius))'
  }
  const hiddenLink: Keyframe = { opacity: '0', transform: 'translateY(-4px)' }

  function finishDisclosure(item: HTMLDetailsElement, expanded: boolean) {
    const motion = motions.get(item)
    motions.delete(item)
    item.open = expanded
    item.querySelector('nav')!.inert = false
    motion?.animations.forEach((animation) => animation.cancel())
  }

  function setDisclosure(item: HTMLDetailsElement, expanded: boolean) {
    const previous = motions.get(item)
    if ((previous?.expanded ?? item.open) === expanded) return
    const nav = item.matches('.mobile-menu') ? item.querySelector('nav') : null
    if (!nav || reducedMotion.matches) {
      if (nav) finishDisclosure(item, expanded)
      else item.open = expanded
      return
    }

    const wasOpen = item.open
    item.open = true
    const links = [...nav.querySelectorAll('a')]
    const elements = [nav, ...links]
    // Capture before cancellation so every reversal starts at its visible frame.
    const frames = elements.map((element, index) => {
      const style = getComputedStyle(element)
      const resting: Keyframe = { opacity: '1', transform: 'none' }
      if (index === 0) resting.clipPath = 'inset(-12px -28px -32px -28px round var(--radius))'
      return {
        from: wasOpen
          ? {
              opacity: style.opacity,
              transform: style.transform,
              ...(index === 0 ? { clipPath: style.clipPath } : {})
            }
          : index === 0
            ? hiddenPanel
            : hiddenLink,
        to: expanded ? resting : index === 0 ? hiddenPanel : hiddenLink
      }
    })
    previous?.animations.forEach((animation) => animation.cancel())
    nav.inert = !expanded
    const distance = Math.abs(Number(expanded) - Number(frames[0].from.opacity))
    const duration = (expanded ? 340 : 280) * (previous ? Math.max(0.35, distance) : 1)
    const motion = {
      expanded,
      animations: elements.map((element, index) =>
        element.animate([frames[index].from, frames[index].to], {
          duration: index === 0 ? duration : duration * 0.65,
          delay:
            previous || index === 0
              ? 0
              : expanded
                ? 20 + (index - 1) * 18
                : (links.length - index) * 12,
          easing: expanded ? 'cubic-bezier(0.22, 1, 0.36, 1)' : 'cubic-bezier(0.32, 0, 0.2, 1)',
          fill: 'both'
        })
      )
    }
    motions.set(item, motion)
    Promise.allSettled(motion.animations.map((animation) => animation.finished)).then(() => {
      if (motions.get(item) === motion) finishDisclosure(item, expanded)
    })
  }

  reducedMotion.addEventListener('change', () => {
    if (reducedMotion.matches)
      motions.forEach((motion, item) => finishDisclosure(item, motion.expanded))
  })
  disclosures.forEach((item) => {
    item.querySelector('summary')?.addEventListener('click', (event) => {
      event.preventDefault()
      setDisclosure(item, !(motions.get(item)?.expanded ?? item.open))
    })
  })
  let previousY = window.scrollY
  let scheduled = false
  function updateHeader() {
    const y = window.scrollY
    header.classList.toggle('is-scrolled', y > 24)
    header.classList.toggle(
      'is-hidden',
      y > 350 &&
        y > previousY &&
        !disclosures.some((item) => item.open) &&
        !header.contains(document.activeElement)
    )
    previousY = y
    scheduled = false
  }
  window.addEventListener(
    'scroll',
    () => {
      if (!scheduled) {
        requestAnimationFrame(updateHeader)
        scheduled = true
      }
    },
    { passive: true }
  )
  disclosures.forEach((item) =>
    item.addEventListener('toggle', () => {
      if (item.open) {
        header.classList.remove('is-hidden')
        disclosures.forEach((other) => {
          if (other !== item) setDisclosure(other, false)
        })
      }
    })
  )
  function closeOutside(event: Event) {
    disclosures.forEach((item) => {
      if (!item.contains(event.target as Node)) setDisclosure(item, false)
    })
  }
  // Touching blank space in Safari can omit the synthetic click event.
  document.addEventListener('pointerdown', closeOutside)
  document.addEventListener('click', closeOutside)
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape')
      disclosures.forEach((item) => {
        if (item.open) {
          setDisclosure(item, false)
          item.querySelector('summary')?.focus()
        }
      })
  })
  updateHeader()
</script>
