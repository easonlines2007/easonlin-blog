---
import { localeFromPath } from '@/lib/i18n'

interface Props {
  title: string
  englishTitle: string
}
const { title, englishTitle } = Astro.props
const locale = localeFromPath(Astro.url.pathname)
---

<h1 class="section-title">
  {title}
  {locale !== 'en' && <span aria-hidden="true"> / {englishTitle}</span>}
</h1>

<style>
  .section-title,
  :global(.page-heading) .section-title {
    font-size: clamp(40px, 5vw, 62px);
    font-weight: 400;
    letter-spacing: 0.08em;
    line-height: 1.3;
  }
  .section-title span {
    margin-left: 16px;
    font-size: 20px;
    font-style: italic;
    letter-spacing: 0;
    color: var(--secondary);
  }
  @media (max-width: 600px) {
    .section-title span {
      margin-left: 8px;
      font-size: 17px;
    }
  }
</style>
