---
import { localeFromPath } from '@/lib/i18n'
import TypewriterText from './TypewriterText.astro'

interface Props {
  title: string
  englishTitle: string
}
const { title, englishTitle } = Astro.props
const locale = localeFromPath(Astro.url.pathname)
---

<h1 class="section-title" aria-label={title} data-title-typing>
  <TypewriterText text={title} translation={locale === 'en' ? undefined : englishTitle} />
</h1>

<style>
  .section-title,
  :global(.page-heading) .section-title {
    font-size: clamp(40px, 5vw, 62px);
    font-weight: 400;
    letter-spacing: 0.08em;
    line-height: 1.3;
  }
</style>
