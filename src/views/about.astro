---
import { localeFromPath, useTranslations } from '@/lib/i18n'
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHeader from '@/components/PageHeader.astro'
import ContactCards from '@/components/ContactCards.astro'
import { theme } from '@/site.config'
const locale = localeFromPath(Astro.url.pathname)
const t = useTranslations(locale)
---

<BaseLayout title={t('关于')}>
  <PageHeader title={t('关于')} />
  <div class="simple-content prose enter delay-1">
    <p>
      🇨🇳～～🇪🇸 Barcelona, Spain
      <br />
      {t('Universitat Politècnica de Catalunya，FIB，AI，大一菜鸟 freshman')}
    </p>
    <p>
      {locale === 'en'
        ? `${theme.author}’s personal notebook: study notes, reading annotations, and questions worth returning to.`
        : `这里是 ${theme.author} 的个人笔记本，收集学习中的记录、阅读时的批注，以及值得再想一想的问题。`}
    </p>
    <h2>{t('记录的方法')}</h2>
    <p>
      {locale === 'en'
        ? 'I organize written notes in Obsidian and keep handwritten derivations and PDF annotations in Goodnotes. Related material is grouped into topics and connected through tags.'
        : '文字在 Obsidian 里整理，手写推导和 PDF 批注留在 Goodnotes。相关内容按专题归档，再用标签连接起来。'}
    </p>
    <p>
      {t(
        '“进行中”代表仍在补充与修订；“已整理”代表完成了一次梳理，之后也会继续更新；“已完成”代表相关学习内容和笔记均已完成。'
      )}
    </p>
  </div>
  <section class="contact-section enter delay-1" aria-labelledby="contact">
    <div class="contact-intro">
      <span class="contact-eyebrow">CONTACT</span>
      <h2 id="contact">{t('如何联系我')}</h2>
      <p>{t('欢迎交流学习、阅读和日常。添加好友时，请简单说明来意。')}</p>
    </div>
    <ContactCards />
  </section>
</BaseLayout>
<style>
  .contact-section {
    margin-top: 56px;
    padding-top: 36px;
    border-top: 1px solid var(--line);
  }
  .contact-eyebrow {
    font-size: 10px;
    letter-spacing: 0.15em;
    color: var(--accent);
  }
  .contact-intro h2 {
    font-family: var(--font-editorial);
    font-size: var(--heading-size);
    font-weight: 400;
    margin: 8px 0 12px;
  }
  .contact-intro p {
    font-size: 14px;
    color: var(--secondary);
    margin-bottom: 28px;
  }
</style>
