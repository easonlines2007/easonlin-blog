---
import { localeFromPath, useTranslations } from '@/lib/i18n'
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHeader from '@/components/PageHeader.astro'
import ContactCards from '@/components/ContactCards.astro'
import SupportSection from '@/components/SupportSection.astro'
import GitHubProfile from '@/components/GitHubProfile.astro'
const locale = localeFromPath(Astro.url.pathname)
const t = useTranslations(locale)
---

<BaseLayout title={t('关于')}>
  <PageHeader title={t('关于')} englishTitle="About" />
  <div class="simple-content prose enter delay-1">
    <p>
      🇨🇳～～🇪🇸 Barcelona, Spain
      <br />
      {t('Universitat Politècnica de Catalunya，FIB，AI，大一菜鸟 freshman')}
    </p>
    <p>
      {locale === 'en'
        ? 'Welcome to Eason Lin’s blog, where I share study notes, personal projects, and everyday essays.'
        : '欢迎来到 Eason Lin 的博客，这里主要放些学习笔记，个人项目 与 日常随笔。'}
    </p>
  </div>
  <GitHubProfile />
  <section class="contact-section enter delay-1" aria-labelledby="contact">
    <div class="contact-intro">
      <span class="contact-eyebrow">CONTACT</span>
      <h2 id="contact">{t('如何联系我')}</h2>
      <p>{t('欢迎交流学习、阅读和日常。添加好友时，请简单说明来意。')}</p>
    </div>
    <ContactCards />
  </section>
  <SupportSection />
</BaseLayout>
<style>
  .contact-section {
    margin-top: 56px;
    padding-top: 36px;
    border-top: 1px solid var(--line);
  }
  .contact-eyebrow {
    font-size: 10px;
    letter-spacing: 0.15em;
    color: var(--accent);
  }
  .contact-intro h2 {
    font-family: var(--font-editorial);
    font-size: var(--heading-size);
    font-weight: 400;
    margin: 8px 0 12px;
  }
  .contact-intro p {
    font-size: 14px;
    color: var(--secondary);
    margin-bottom: 28px;
  }
</style>
