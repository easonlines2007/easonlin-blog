---
import { localeFromPath, localizePath, useTranslations } from '@/lib/i18n'
const locale = localeFromPath(Astro.url.pathname)
const t = useTranslations(locale)
const path = (href: string) => localizePath(href, locale)
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout
  title={t('页面未找到')}
  alternatePath={locale === 'en' ? '/404.html' : '/en/404/'}
  noindex
>
  <div class="page-heading enter">
    <p>404</p>
    <h1>{t('这一页还没有写下。')}</h1>
    <p>{t('链接可能已变更，可以回到笔记列表继续寻找。')}</p>
  </div>
  <a class="pill-link" href={path('/notes')}>
    <span class="lift-text">{t('返回笔记')}</span>
  </a>
</BaseLayout>

<script>
  // Static hosts share the root 404 document for unknown URLs.
  if (location.pathname.startsWith('/en/') && !/^\/en\/404\/?$/.test(location.pathname)) {
    location.replace('/en/404/')
  }
</script>
