---
import { localeFromPath, localizePath, useTranslations } from '@/lib/i18n'
import NotesLayout from '@/layouts/NotesLayout.astro'

const locale = localeFromPath(Astro.url.pathname)
const t = useTranslations(locale)
const path = (href: string) => localizePath(href, locale)
const { tag, notes, allNotes } = Astro.props
---

<NotesLayout
  title={`# ${tag}`}
  {notes}
  {allNotes}
  back={path('/notes/tags')}
  backLabel={t('全部标签')}
/>
