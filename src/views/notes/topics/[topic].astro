---
import { localeFromPath, localizePath, useTranslations } from '@/lib/i18n'
import NotesLayout from '@/layouts/NotesLayout.astro'
import { getNotes } from '@/lib/notes'

const locale = localeFromPath(Astro.url.pathname)
const t = useTranslations(locale)
const path = (href: string) => localizePath(href, locale)
const { topic, notes, allNotes } = Astro.props
const alternateLocale = locale === 'en' ? 'zh' : 'en'
const hasAlternate = (await getNotes(alternateLocale)).some((note) => note.data.topic === topic)
---

<NotesLayout
  title={topic}
  {notes}
  {allNotes}
  back={path('/notes/topics')}
  backLabel={t('全部专题')}
  alternatePath={hasAlternate ? localizePath(Astro.url.pathname, alternateLocale) : null}
/>
