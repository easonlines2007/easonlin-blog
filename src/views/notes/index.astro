---
import { localeFromPath, localizePath, useTranslations, noteCount } from '@/lib/i18n'
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHeader from '@/components/PageHeader.astro'
import Icon from '@/components/Icon.astro'
import { getNotes } from '@/lib/notes'
import { countValues, topicUrl } from '@/lib/note-utils'
import { getTopics } from '@/lib/topics'
import TopicPin from '@/components/TopicPin.astro'
const locale = localeFromPath(Astro.url.pathname)
const t = useTranslations(locale)
const path = (href: string) => localizePath(href, locale)
const notes = await getNotes(locale)
const topics = getTopics(notes)
const tags = countValues(notes, 'tags')
---

<BaseLayout title={t('笔记')}>
  <PageHeader title={t('笔记')} description={t('从一篇笔记、一个专题，或一个关键词开始读。')} />
  <div class="notes-hub enter delay-1">
    <a class="index-card" href={path('/notes/all')}>
      <div>
        <h2 class="lift-text">{t('全部笔记')}</h2>
        <p>
          {locale === 'en'
            ? `${noteCount(notes.length, locale)}, sortable by date or title`
            : `${notes.length} 篇笔记，可按日期或标题排序`}
        </p>
      </div>
      <Icon name="next" />
    </a>
    <section class="notes-hub-topics" aria-labelledby="notes-topics-title">
      <div class="notes-hub-heading">
        <h2 id="notes-topics-title">{t('专题')}</h2>
        <span>{locale === 'en' ? `${topics.length} topics` : `${topics.length} 个专题`}</span>
      </div>
      <div class="index-grid">
        {topics.map(([topic, count]) => (
          <a class="index-card" href={path(topicUrl(topic))}>
            <div>
              <h3 class="lift-text">
                {topic}
                <TopicPin {topic} />
              </h3>
              <p>{noteCount(count, locale)}</p>
            </div>
            <Icon name="next" />
          </a>
        ))}
      </div>
      {!topics.length && <p class="empty-state">{t('还没有公开专题。')}</p>}
    </section>
    <div class="index-grid">
      <a class="index-card" href={path('/notes/tags')}>
        <div>
          <h2 class="lift-text">{t('标签')}</h2>
          <p>
            {locale === 'en'
              ? `${tags.length} keywords to explore related notes`
              : `${tags.length} 个关键词，找到相关笔记`}
          </p>
        </div>
        <Icon name="next" />
      </a>
      <a class="index-card" href={path('/notes/status')}>
        <div>
          <h2 class="lift-text">{t('整理状态')}</h2>
          <p>{t('进行中、已整理与已完成的笔记')}</p>
        </div>
        <Icon name="next" />
      </a>
    </div>
  </div>
</BaseLayout>
