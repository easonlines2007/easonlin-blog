---
import { localeFromPath, localizePath, useTranslations, noteCount } from '@/lib/i18n'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getNotes } from '@/lib/notes'
import { getEssays } from '@/lib/essays'
import { essayUrl } from '@/lib/essay-utils'
import { topicUrl } from '@/lib/note-utils'
import { getTopics } from '@/lib/topics'
import { projects } from '@/lib/projects'
import HomeAvatar from '@/components/HomeAvatar.astro'
import HomeEntrance from '@/components/HomeEntrance.astro'
import HomeRow from '@/components/HomeRow.astro'
import HomeMotto from '@/components/HomeMotto.astro'
import Wordmark from '@/components/Wordmark.astro'
const locale = localeFromPath(Astro.url.pathname)
const t = useTranslations(locale)
const path = (href: string) => localizePath(href, locale)
const notes = await getNotes(locale)
const essays = await getEssays(locale)
const topics = getTopics(notes)
---

<BaseLayout title={t('首页')} home>
  <HomeEntrance slot="head" />
  <section class="home-intro">
    <HomeAvatar />
    <h1 data-intro-name>
      <Wordmark kind="name" />
    </h1>
    <HomeMotto />
  </section>
  <div class="home-sections">
    <section class="home-section entry-surface" data-intro-reveal>
      <h2>
        <a class="home-section-link entry-link" href={path('/about')}>
          <span class="section-index" aria-hidden="true">
            01
          </span>
          <span class="lift-text">{t('关于')}</span>
        </a>
      </h2>
      <div class="section-body">
        <ul class="home-row-list">
          <HomeRow title={t('“史努比的红狗屋”')} href={path('/about')} />
        </ul>
        <a class="more-link" href={path('/about')}>
          <span class="lift-text">{t('更多关于这里')}</span>
        </a>
      </div>
    </section>
    <section class="home-section entry-surface" data-intro-reveal>
      <h2>
        <a class="home-section-link entry-link" href={path('/notes')}>
          <span class="section-index" aria-hidden="true">
            02
          </span>
          <span class="lift-text">{t('笔记')}</span>
        </a>
      </h2>
      <div class="section-body">
        <ul class="home-row-list">
          {topics.slice(0, 4).map(([topic, count]) => (
            <HomeRow
              title={topic}
              meta={noteCount(count, locale)}
              href={path(topicUrl(topic))}
              pinTopic={topic}
            />
          ))}
        </ul>
        <a class="more-link" href={path('/notes')}>
          <span class="lift-text">{t('全部笔记')}</span>
        </a>
      </div>
    </section>
    <section class="home-section entry-surface" data-intro-reveal>
      <h2>
        <a class="home-section-link entry-link" href={path('/blog')}>
          <span class="section-index" aria-hidden="true">
            03
          </span>
          <span class="lift-text">{t('随笔')}</span>
        </a>
      </h2>
      <div class="section-body">
        <ul class="home-row-list">
          {essays.slice(0, 3).map((essay) => (
            <HomeRow label={t('随笔')} title={essay.data.title} href={path(essayUrl(essay.id))} />
          ))}
        </ul>
        <a class="more-link" href={path('/blog')}>
          <span class="lift-text">{t('全部随笔')}</span>
        </a>
      </div>
    </section>
    <section class="home-section entry-surface" data-intro-reveal>
      <h2>
        <a class="home-section-link entry-link" href={path('/projects')}>
          <span class="section-index" aria-hidden="true">
            04
          </span>
          <span class="lift-text">{t('项目')}</span>
        </a>
      </h2>
      <div class="section-body">
        <ul class="home-row-list">
          {projects
            .filter((project) => !project.fork)
            .slice(0, 3)
            .map((project) => (
              <HomeRow label="GitHub" title={project.name} href={project.url} external />
            ))}
        </ul>
        <a class="more-link" href={path('/projects')}>
          <span class="lift-text">{t('全部项目与 GitHub 动态')}</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
