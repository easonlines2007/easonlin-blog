---
import Header from '../components/Header.astro'
import Icon from '../components/Icon.astro'
import { theme } from '../site.config'
import '../styles/fonts.css'
import '../styles/global.css'
import { localeFromPath, localizePath, useTranslations } from '../lib/i18n'
interface Props {
  title: string
  description?: string
  home?: boolean
  noindex?: boolean
  alternatePath?: string | null
}
const { title, description = theme.description, home = false, noindex = false } = Astro.props
const locale = localeFromPath(Astro.url.pathname)
const t = useTranslations(locale)
const alternatePath =
  Astro.props.alternatePath === undefined
    ? localizePath(Astro.url.pathname, locale === 'en' ? 'zh' : 'en')
    : Astro.props.alternatePath
const canonical = new URL(Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang={locale === 'en' ? 'en' : 'zh-CN'} data-theme-preference="system">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{t(title)} · {theme.title}</title>
    {description && <meta name="description" content={t(description)} />}
    <meta name="theme-color" content="#f7f6f2" />
    <meta name="color-scheme" content="light dark" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Eason's Notes" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonical} />
    {alternatePath && (
      <>
        <link rel="alternate" hreflang={locale === 'en' ? 'en' : 'zh-CN'} href={canonical} />
        <link
          rel="alternate"
          hreflang={locale === 'en' ? 'zh-CN' : 'en'}
          href={
            new URL(
              alternatePath.endsWith('/') || /\.[a-z0-9]+$/i.test(alternatePath)
                ? alternatePath
                : `${alternatePath}/`,
              Astro.site
            )
          }
        />
      </>
    )}
    <link
      rel="preload"
      href="/fonts/schoolbell-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/lxgw-marker-gothic-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={theme.title}
      href={localizePath('/rss.xml', locale)}
    />
    <meta property="og:title" content={`${t(title)} · ${theme.title}`} />
    {description && <meta property="og:description" content={t(description)} />}
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'zh_CN'} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <script is:inline>
      ;(() => {
        let choice = 'system'
        try {
          const saved = localStorage.getItem('notes-theme')
          if (saved === 'light' || saved === 'dark') choice = saved
        } catch {}
        const dark =
          choice === 'dark' ||
          (choice === 'system' && matchMedia('(prefers-color-scheme: dark)').matches)
        document.documentElement.classList.toggle('dark', dark)
        document.documentElement.dataset.themePreference = choice
        document.documentElement.style.colorScheme = dark ? 'dark' : 'light'
        document.querySelector('meta[name="theme-color"]').content = dark ? '#1e1c1a' : '#f7f6f2'
      })()
    </script>
    <!-- Vercel Web Analytics: lightweight script, no build dependency required. -->
    <script is:inline>
      window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments) }
    </script>
    <script is:inline defer src="/_vercel/insights/script.js"></script>
    <slot name="head" />
  </head>
  <body class:list={[home && 'home-page']}>
    <a class="skip-link" href="#main">
      {t('跳转到正文')}
    </a>
    <div class="site-container">
      <Header {alternatePath} />
      <main id="main" class="page-content" tabindex="-1">
        <slot />
      </main>
      <footer class="site-footer" data-pagefind-ignore>
        <div>
          <span>
            © {new Date().getFullYear()} {theme.author}
          </span>
          <span class="footer-credit">
            <a href="https://astro.build">
              <span class="lift-text">Astro</span>
            </a>{' '}
            &{' '}
            <a href="https://github.com/cworld1/astro-theme-pure">
              <span class="lift-text">Pure</span>
            </a>
          </span>
        </div>
        <nav class="footer-links" aria-label={t('页脚链接')}>
          <a href={localizePath('/admin', locale)}>
            <span class="lift-text">{t('文章管理')}</span>
          </a>
          <a
            href={localizePath('/rss.xml', locale)}
            class="icon-button"
            aria-label={t('订阅 RSS')}
            title={t('订阅 RSS')}
          >
            <Icon name="rss" />
          </a>
        </nav>
      </footer>
    </div>
  </body>
</html>
