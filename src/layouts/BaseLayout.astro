---
import Header from '../components/Header.astro'
import Icon from '../components/Icon.astro'
import { theme } from '../site.config'
import '../styles/fonts.css'
import '../styles/global.css'
interface Props {
  title: string
  description?: string
  home?: boolean
  noindex?: boolean
}
const { title, description = theme.description, home = false, noindex = false } = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang="zh-CN" data-theme-preference="system">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} · {theme.title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f6f2" />
    <meta name="color-scheme" content="light dark" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Eason's Notes" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonical} />
    <link
      rel="preload"
      href="/fonts/schoolbell-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/lxgw-marker-gothic-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="alternate" type="application/rss+xml" title={theme.title} href="/rss.xml" />
    <meta property="og:title" content={`${title} · ${theme.title}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <script is:inline>
      ;(() => {
        let choice = 'system'
        try {
          const saved = localStorage.getItem('notes-theme')
          if (saved === 'light' || saved === 'dark') choice = saved
        } catch {}
        const dark =
          choice === 'dark' ||
          (choice === 'system' && matchMedia('(prefers-color-scheme: dark)').matches)
        document.documentElement.classList.toggle('dark', dark)
        document.documentElement.dataset.themePreference = choice
        document.documentElement.style.colorScheme = dark ? 'dark' : 'light'
        document.querySelector('meta[name="theme-color"]').content = dark ? '#1e1c1a' : '#f7f6f2'
      })()
    </script>
    <slot name="head" />
  </head>
  <body class:list={[home && 'home-page']}>
    <a class="skip-link" href="#main">
      跳转到正文
    </a>
    <div class="site-container">
      <Header />
      <main id="main" class="page-content" tabindex="-1">
        <slot />
      </main>
      <footer class="site-footer" data-pagefind-ignore>
        <div>
          <span>
            © {new Date().getFullYear()} {theme.author}
          </span>
          <span class="footer-credit">
            <a href="https://astro.build">
              <span class="lift-text">Astro</span>
            </a>{' '}
            &{' '}
            <a href="https://github.com/cworld1/astro-theme-pure">
              <span class="lift-text">Pure</span>
            </a>
          </span>
        </div>
        <nav class="footer-links" aria-label="页脚链接">
          <a href="/admin">
            <span class="lift-text">文章管理</span>
          </a>
          <a href="/rss.xml" class="icon-button" aria-label="订阅 RSS" title="订阅 RSS">
            <Icon name="rss" />
          </a>
        </nav>
      </footer>
    </div>
  </body>
</html>
