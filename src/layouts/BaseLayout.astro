---
import Header from '../components/Header.astro'
import Icon from '../components/Icon.astro'
import { theme } from '../site.config'
import '../styles/global.css'
interface Props {
  title: string
  description?: string
  home?: boolean
  noindex?: boolean
}
const { title, description = theme.description, home = false, noindex = false } = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang="zh-CN" data-theme-preference="system">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} · {theme.title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f6f2" />
    <meta name="color-scheme" content="light dark" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={theme.title} href="/rss.xml" />
    <meta property="og:title" content={`${title} · ${theme.title}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <script is:inline>
      ;(() => {
        let choice = 'system'
        try {
          const saved = localStorage.getItem('notes-theme')
          if (saved === 'light' || saved === 'dark') choice = saved
        } catch {}
        const dark =
          choice === 'dark' ||
          (choice === 'system' && matchMedia('(prefers-color-scheme: dark)').matches)
        document.documentElement.classList.toggle('dark', dark)
        document.documentElement.dataset.themePreference = choice
        document.documentElement.style.colorScheme = dark ? 'dark' : 'light'
        document.querySelector('meta[name="theme-color"]').content = dark ? '#1e1c1a' : '#f7f6f2'
      })()
    </script>
    <slot name="head" />
  </head>
  <body class:list={[home && 'home-page']}>
    <a class="skip-link" href="#main">
      跳转到正文
    </a>
    <div class="site-container">
      <Header />
      <main id="main" class="page-content" tabindex="-1">
        <slot />
      </main>
      <footer class="site-footer" data-pagefind-ignore>
        <div>
          <span>
            © {new Date().getFullYear()} {theme.author}
          </span>
          <span class="footer-credit">
            <a href="https://astro.build">Astro</a> &{' '}
            <a href="https://github.com/cworld1/astro-theme-pure">Pure</a>
          </span>
        </div>
        <a href="/rss.xml" class="icon-button" aria-label="订阅 RSS" title="订阅 RSS">
          <Icon name="rss" />
        </a>
      </footer>
    </div>
  </body>
</html>
