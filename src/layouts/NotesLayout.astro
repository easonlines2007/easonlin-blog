---
import type { CollectionEntry } from 'astro:content'
import BaseLayout from './BaseLayout.astro'
import PageHeader from '../components/PageHeader.astro'
import NotesSidebar from '../components/NotesSidebar.astro'
import NoteCard from '../components/NoteCard.astro'
import ListToolbar from '../components/ListToolbar.astro'
interface Props {
  title: string
  notes: CollectionEntry<'notes'>[]
  allNotes?: CollectionEntry<'notes'>[]
  description?: string
  back?: string
  backLabel?: string
  filters?: boolean
}
const { title, notes, allNotes = notes, description, back, backLabel, filters = true } = Astro.props
---

<BaseLayout {title}>
  <PageHeader {title} {description} {back} {backLabel} />
  <div class="listing-grid enter delay-1" data-sortable-listing data-list-label="笔记">
    <div>
      <ListToolbar count={notes.length} />
      <ul class="notes-list" data-list-items>
        {notes.map((note) => (
          <NoteCard {note} />
        ))}
      </ul>
      <p class="empty-state" data-filter-empty hidden={notes.length > 0}>
        {notes.length ? '这个状态下还没有笔记。' : '还没有符合条件的公开笔记。'}
      </p>
    </div>
    <NotesSidebar notes={allNotes} filterNotes={notes} filters={filters && notes.length > 0} />
  </div>
</BaseLayout>
