---
import type { CollectionEntry } from 'astro:content'
import BaseLayout from './BaseLayout.astro'
import PageHeader from '../components/PageHeader.astro'
import NotesSidebar from '../components/NotesSidebar.astro'
import NoteCard from '../components/NoteCard.astro'
interface Props {
  title: string
  notes: CollectionEntry<'notes'>[]
  allNotes?: CollectionEntry<'notes'>[]
  description?: string
  back?: string
  backLabel?: string
}
const { title, notes, allNotes = notes, description, back, backLabel } = Astro.props
---

<BaseLayout {title}>
  <PageHeader {title} {description} {back} {backLabel} />
  <div class="listing-grid enter delay-1">
    <div>
      <p class="list-count" role="status" aria-live="polite" data-note-count>
        共 {notes.length} 篇笔记
      </p>
      <ul class="notes-list">
        {notes.map((note) => (
          <NoteCard {note} />
        ))}
      </ul>
      <p class="empty-state" data-filter-empty hidden={notes.length > 0}>
        {notes.length ? '这个状态下还没有笔记。' : '还没有公开笔记。'}
      </p>
    </div>
    <NotesSidebar notes={allNotes} filterNotes={notes} filters={notes.length > 0} />
  </div>
</BaseLayout>
<script>
  const cards = [...document.querySelectorAll<HTMLElement>('[data-note-status]')]
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-status-filter]')]
  buttons.forEach((button) =>
    button.addEventListener('click', () => {
      const status = button.dataset.statusFilter
      let visible = 0
      cards.forEach((card) => {
        card.hidden = status !== 'all' && card.dataset.noteStatus !== status
        if (!card.hidden) visible++
      })
      buttons.forEach((other) => other.setAttribute('aria-pressed', String(other === button)))
      const count = document.querySelector('[data-note-count]')
      if (count) count.textContent = `共 ${visible} 篇笔记`
      document.querySelector<HTMLElement>('[data-filter-empty]')!.hidden = visible > 0
    })
  )
</script>
