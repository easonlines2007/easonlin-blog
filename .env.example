# Production origin used by canonical links, RSS and the sitemap.
SITE_URL=https://easonlin-blog.vercel.app

# Server-only author authentication, production environment only. Never prefix with PUBLIC_.
MOTTO_ADMIN_PASSWORD_HASH=
MOTTO_SESSION_SECRET=
# Connected private Vercel Blob store; Vercel supplies its OIDC token at runtime.
BLOB_STORE_ID=

# Local sync only. Absolute Obsidian Vault root (not its Blog directory).
OBSIDIAN_VAULT_PATH=
