# Production origin used by canonical links, RSS and the sitemap.
SITE_URL=https://easonlin-blog.vercel.app

# Server-only author authentication, production environment only. Never prefix with PUBLIC_.
MOTTO_ADMIN_PASSWORD_HASH=
MOTTO_SESSION_SECRET=
# /admin shares the author session above. Configure these only in Vercel Production.
# Fine-grained GitHub token: only this repository, Contents read/write. Never PUBLIC_.
BLOG_GITHUB_TOKEN=
BLOG_GITHUB_OWNER=easonlines2007
BLOG_GITHUB_REPO=easonlin-blog
BLOG_GITHUB_BRANCH=main
# Connected private Vercel Blob store; Vercel supplies its OIDC token at runtime.
BLOB_STORE_ID=

# Local sync only. Absolute Obsidian Vault root (not its Blog directory).
OBSIDIAN_VAULT_PATH=
# Optional: true publishes ALL Vault Markdown, including drafts; default is Blog/publish:true only.
OBSIDIAN_PUBLISH_ALL=false
