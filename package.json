{
  "name": "eason-notes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "node scripts/prepare-pdf-assets.mjs && astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "node scripts/prepare-pdf-assets.mjs && astro check && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "verify": "pnpm test && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.0",
    "@astrojs/rss": "4.0.18",
    "@pagefind/default-ui": "1.5.2",
    "astro": "6.4.8",
    "astro-pure": "1.4.9",
    "katex": "0.16.47",
    "pdfjs-dist": "6.3.289",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@unocss/reset": "66.10.5",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "typescript": "6.0.3",
    "unocss": "66.10.5"
  }
}
